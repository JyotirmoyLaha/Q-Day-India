{
  "name": "qday-india",
  "private": true,
  "description": "Scan India's websites and your code for quantum risk — then fix it.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.5 <25"
  },
  "scripts": {
    "build": "pnpm --filter @qday/cbom-engine build && pnpm --filter web build",
    "test": "pnpm -r --workspace-concurrency=1 test && node scripts/validate-scan.mjs",
    "lint": "pnpm -r lint && prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "validate:scan": "node scripts/validate-scan.mjs",
    "scan:build": "cd scanner && go build -o bin/qday-scan ./cmd/qday-scan",
    "scan": "cd scanner && go run ./cmd/qday-scan --targets ../targets/india.yaml --out ../data",
    "go:test": "cd scanner && go vet ./... && go test ./...",
    "dogfood": "node scripts/dogfood.mjs",
    "set-owner": "node scripts/set-owner.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
